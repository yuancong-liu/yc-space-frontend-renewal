{
  "name": "yc-space",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:site": "turbo run dev --filter=@yc/site",
    "dev:cms": "turbo run dev --filter=@yc/cms",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:coverage": "turbo run test:coverage",
    "e2e": "turbo run e2e",
    "e2e:ui": "turbo run e2e:ui",
    "storybook": "turbo run storybook",
    "storybook:build": "turbo run storybook:build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "import-posts": "bun run scripts/import-posts.ts"
  },
  "devDependencies": {
    "@yc/markdown": "workspace:*",
    "gray-matter": "^4.0.3",
    "prettier": "^3.9.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "turbo": "^2.10.13"
  }
}
