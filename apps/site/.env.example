# Copy to .env.local and fill in. Never commit the filled-in file.

# Supabase → Project Settings → API. The site reads with the anon key only;
# row level security is what keeps drafts invisible.
# Unset is fine — the data layer degrades to empty so `next build` and CI run
# without secrets.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only, hence no NEXT_PUBLIC_ prefix — nothing in the browser reads
# these two, so they stay out of the client bundle.
#
# Which deployment this is: production | staging | development.
# Only `production` is indexed by crawlers and hides the environment banner.
# On Vercel this can stay unset while one project serves the site — VERCEL_ENV
# says it correctly. Set it the day a second project does: a staging project
# has its own production branch, so VERCEL_ENV would claim production there too.
SITE_ENV=development

# Canonical origin of this deployment, for metadataBase, canonicals and the
# sitemap. Falls back to https://$VERCEL_URL, then http://localhost:3000.
SITE_URL=https://example.com

# Shared secret the CMS presents to /api/revalidate so publishing refreshes
# this deployment immediately. Each deployment holds its own; unset means the
# endpoint refuses everything and pages wait out their revalidate window.
REVALIDATE_SECRET=a-long-random-string
