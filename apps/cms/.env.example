# Copy to .env.local and fill in. Never commit the filled-in file.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Comma-separated list of e-mail addresses allowed to sign in.
# Empty or unset locks everyone out — this gate fails closed on purpose.
# Read by the edge proxy, so Next inlines it at build time: changing it on
# Vercel needs a redeploy, not just an env update.
CMS_ALLOWED_EMAILS=you@example.com

# Public origin of this app, used to build the sign-in e-mail link.
# Local dev can leave it unset; it falls back to http://localhost:3001.
NEXT_PUBLIC_CMS_URL=https://cms.example.com

# Site deployments to refresh when a post is written, comma-separated.
# Production and staging serve the same content from different origins, so
# publishing should reach both. Unset means neither: each site then waits out
# its own revalidate window. Read at request time — no redeploy needed.
SITE_REVALIDATE_ORIGINS=https://example.com,https://stg.example.com

# Shared with every origin above, as the site's own REVALIDATE_SECRET.
# Without it nothing is sent at all, rather than asking unauthenticated.
REVALIDATE_SECRET=a-long-random-string
