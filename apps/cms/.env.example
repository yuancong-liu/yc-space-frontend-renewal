# Copy to .env.local and fill in. Never commit the filled-in file.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Comma-separated list of e-mail addresses allowed to sign in.
# Empty or unset locks everyone out — this gate fails closed on purpose.
# Read by the edge proxy, so Next inlines it at build time: changing it on
# Vercel needs a redeploy, not just an env update.
CMS_ALLOWED_EMAILS=you@example.com

# Public origin of this app, used to build the sign-in e-mail link.
# Local dev can leave it unset; it falls back to http://localhost:3001.
NEXT_PUBLIC_CMS_URL=https://cms.example.com
